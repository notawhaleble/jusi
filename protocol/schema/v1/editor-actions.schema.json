{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusi.dev/protocol/v1/editor-actions.schema.json",
  "title": "Application-originated editor actions",
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "action_id",
        "client_id",
        "runtime_id",
        "notebook_id",
        "cell_id",
        "editor_id",
        "trace_id",
        "action"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notebook_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "editor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "copy",
            "open",
            "show_diff"
          ]
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "content"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "application.editor_action"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "content": {
          "$ref": "responses.schema.json#/$defs/editor_action"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "action_id",
        "outcome",
        "reason"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "application.action_result"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "action_id": {
          "type": "string",
          "maxLength": 128
        },
        "outcome": {
          "enum": [
            "delivered",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "fetch": {
      "type": "object",
      "required": [
        "ok",
        "action",
        "content",
        "remaining_ms"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "$ref": "#/$defs/metadata"
        },
        "content": {
          "$ref": "responses.schema.json#/$defs/editor_action"
        },
        "remaining_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": "integer",
          "minimum": 0
        },
        "eof": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "properties": {
                  "action": {
                    "const": "copy"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "properties": {
                  "action": {
                    "const": "copy"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": {
                  "action": {
                    "const": "open"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "properties": {
                  "action": {
                    "const": "open"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "offset"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "properties": {
                  "text": {
                    "maxLength": 65536,
                    "description": "At most 65536 UTF-8 bytes; next_offset equals offset plus UTF-8 byte length."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": {
                  "action": {
                    "const": "show_diff"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "properties": {
                  "action": {
                    "const": "show_diff"
                  }
                }
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "offset": [
          "offset",
          "next_offset",
          "eof"
        ],
        "next_offset": [
          "offset",
          "next_offset",
          "eof"
        ],
        "eof": [
          "offset",
          "next_offset",
          "eof"
        ]
      }
    },
    "ack": {
      "type": "object",
      "required": [
        "ok",
        "delivery"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "delivery": {
          "type": "object",
          "required": [
            "action_id",
            "outcome",
            "reason"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "outcome": {
              "enum": [
                "delivered",
                "failed"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "begin": {
      "type": "object",
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "content"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "application.editor_action_begin"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "content": {
          "allOf": [
            {
              "$ref": "responses.schema.json#/$defs/editor_action"
            },
            {
              "properties": {
                "text": {
                  "const": ""
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "text",
        "eof"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "application.editor_action_chunk"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 65536,
          "pattern": "^[^\\u0000]*$",
          "description": "At most 65536 UTF-8 bytes per chunk."
        },
        "eof": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "eof": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/begin"
    },
    {
      "$ref": "#/$defs/chunk"
    }
  ]
}
