{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusi.dev/protocol/v1/events.schema.json",
  "title": "Jusi Protocol v1 Events",
  "type": "object",
  "required": [
    "protocol_version",
    "event_id",
    "supervisor_id",
    "sequence",
    "occurred_at",
    "trace_id",
    "layer",
    "operation",
    "kind",
    "resource",
    "payload"
  ],
  "properties": {
    "protocol_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "supervisor_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "layer": {
      "enum": ["protocol", "frontend_transport", "service", "supervisor", "kernel", "execution", "client", "plugin_discovery", "plugin_worker"]
    },
    "operation": {
      "enum": ["service_start", "start_kernel", "stop_kernel", "close_client", "restart_notebook", "execute", "interrupt", "cleanup", "inspect", "connect_events"]
    },
    "kind": {
      "enum": [
        "service.ready",
        "operation.started",
        "operation.completed",
        "kernel.state_changed",
        "execution.started",
        "execution.output",
        "execution.completed",
        "client.created",
        "client.closed",
        "surface.created",
        "surface.closed",
        "failure.occurred"
      ]
    },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["supervisor", "notebook_runtime", "kernel", "execution", "client", "surface", "plugin_discovery", "plugin_worker", "transport", "notebook", "cell"]},
        "id": {"type": "string", "minLength": 3, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "service.ready"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["supervisor_id"],
            "properties": {"supervisor_id": {"type": "string", "minLength": 3}},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "operation.started"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["operation_id", "trace_id", "kind", "outcome", "started_at", "completed_at"],
            "properties": {
              "operation_id": {"type": "string", "minLength": 3},
              "trace_id": {"type": "string", "minLength": 3},
              "kind": {"enum": ["service_start", "start_kernel", "stop_kernel", "close_client", "restart_notebook", "execute", "interrupt", "cleanup", "inspect", "connect_events"]},
              "outcome": {"const": "running"},
              "started_at": {"type": "string", "format": "date-time"},
              "completed_at": {"type": "null"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "operation.completed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["operation_id", "trace_id", "kind", "outcome", "started_at", "completed_at"],
            "properties": {
              "operation_id": {"type": "string", "minLength": 3},
              "trace_id": {"type": "string", "minLength": 3},
              "kind": {"enum": ["service_start", "start_kernel", "stop_kernel", "close_client", "restart_notebook", "execute", "interrupt", "cleanup", "inspect", "connect_events"]},
              "outcome": {"enum": ["succeeded", "failed", "cancelled"]},
              "started_at": {"type": "string", "format": "date-time"},
              "completed_at": {"type": "string", "format": "date-time"},
              "failure_id": {"type": "string", "minLength": 3},
              "cleanup": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "kernel.state_changed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["kernel_id", "previous_state", "state"],
            "properties": {
              "kernel_id": {"type": "string"},
              "previous_state": {"enum": ["off", "on"]},
              "state": {"enum": ["off", "on"]}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "execution.started"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_id", "kernel_id", "notebook_id", "cell_id", "client_id", "outcome", "started_at", "completed_at"],
            "properties": {
              "execution_id": {"type": "string", "minLength": 3},
              "kernel_id": {"type": "string", "minLength": 3},
              "notebook_id": {"type": "string", "minLength": 1},
              "cell_id": {"type": "string", "minLength": 1},
              "client_id": {"type": ["string", "null"], "minLength": 3},
              "outcome": {"const": "running"},
              "started_at": {"type": "string", "format": "date-time"},
              "completed_at": {"type": "null"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "execution.completed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_id", "kernel_id", "notebook_id", "cell_id", "client_id", "outcome", "started_at", "completed_at"],
            "properties": {
              "execution_id": {"type": "string", "minLength": 3},
              "kernel_id": {"type": "string", "minLength": 3},
              "notebook_id": {"type": "string", "minLength": 1},
              "cell_id": {"type": "string", "minLength": 1},
              "client_id": {"type": ["string", "null"], "minLength": 3},
              "outcome": {"enum": ["succeeded", "failed", "interrupted", "cancelled"]},
              "started_at": {"type": "string", "format": "date-time"},
              "completed_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "execution.output"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["execution_id", "client_id", "output_kind", "media_type", "data"],
            "properties": {
              "execution_id": {"type": "string"},
              "client_id": {"type": ["string", "null"]},
              "output_kind": {"enum": ["stdout", "stderr", "result", "display"]},
              "media_type": {"type": "string", "minLength": 1},
              "data": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "client.created"}}},
      "then": {
        "properties": {
          "payload": {"$ref": "responses.schema.json#/$defs/client"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "client.closed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["client_id", "plugin_worker_id", "reason", "closed_at"],
            "properties": {
              "client_id": {"type": "string", "minLength": 3},
              "plugin_worker_id": {"type": "string", "minLength": 3},
              "reason": {"enum": ["explicit_close", "fatal_failure", "runtime_cleanup"]},
              "closed_at": {"type": "string", "format": "date-time"},
              "failure_id": {"type": "string", "minLength": 3}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "surface.created"}}},
      "then": {
        "properties": {
          "payload": {"$ref": "responses.schema.json#/$defs/surface"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "surface.closed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["surface_id", "client_id", "reason", "closed_at"],
            "properties": {
              "surface_id": {"type": "string", "minLength": 3},
              "client_id": {"type": "string", "minLength": 3},
              "reason": {"enum": ["client_cleanup", "fatal_failure"]},
              "closed_at": {"type": "string", "format": "date-time"},
              "failure_id": {"type": "string", "minLength": 3}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "failure.occurred"}}},
      "then": {
        "properties": {
          "payload": {"$ref": "common.schema.json#/$defs/failure"}
        }
      }
    }
  ],
  "additionalProperties": true
}
