{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusi.dev/protocol/v1/responses.schema.json",
  "title": "Jusi Protocol v1 HTTP Responses",
  "$defs": {
    "editor_action": {
  "oneOf": [
    {
      "type": "object",
      "required": [
        "action",
        "text",
        "regtype"
      ],
      "properties": {
        "action": {
          "const": "copy"
        },
        "text": {
          "type": "string",
          "maxLength": 524288,
          "pattern": "^[^\\u0000]*$"
        },
        "regtype": {
          "enum": [
            "v",
            "V"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "action",
        "text",
        "name",
        "filetype"
      ],
      "properties": {
        "action": {
          "const": "open"
        },
        "text": {
          "type": "string",
          "maxLength": 524288,
          "pattern": "^[^\\u0000]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "filetype": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{0,63}|)$"
        }
      },
      "additionalProperties": false
    }
  ]
},
    "completion": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "text",
              "start",
              "end"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 65536,
                "pattern": "^[^\\u0000]*$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "detail": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "documentation": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "kind": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              }
            }
          }
        }
      }
    },
    "input_request": {
      "type": "object",
      "required": [
        "input_request_id",
        "execution_id",
        "kernel_id",
        "notebook_id",
        "cell_id",
        "prompt",
        "password"
      ],
      "properties": {
        "input_request_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "kernel_id": {
          "type": "string",
          "minLength": 1
        },
        "notebook_id": {
          "type": "string",
          "minLength": 1
        },
        "cell_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "password": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["execution_id", "kernel_id", "notebook_id", "cell_id", "client_id", "outcome", "started_at", "completed_at"],
      "properties": {
        "execution_id": {"type": "string", "minLength": 3},
        "kernel_id": {"type": "string", "minLength": 3},
        "notebook_id": {"type": "string", "minLength": 1},
        "cell_id": {"type": "string", "minLength": 1},
        "client_id": {"type": ["string", "null"]},
        "outcome": {"enum": ["running"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "null"}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["surface_id", "client_id", "runtime_id", "kind", "capabilities", "transport", "created_at"],
      "properties": {
        "surface_id": {"type": "string", "minLength": 3},
        "client_id": {"type": "string", "minLength": 3},
        "runtime_id": {"type": "string", "minLength": 3},
        "kind": {"const": "terminal"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["input", "resize", "signal"]},
          "allOf": [
            {"contains": {"const": "input"}},
            {"contains": {"const": "resize"}}
          ]
        },
        "transport": {
          "type": "object",
          "required": ["kind", "endpoint", "subprotocol"],
          "properties": {
            "kind": {"const": "websocket"},
            "endpoint": {"type": "string", "pattern": "^/", "minLength": 1},
            "subprotocol": {"const": "jusi.terminal.v1"}
          },
          "additionalProperties": false
        },
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "required": ["client_id", "runtime_id", "kernel_id", "notebook_id", "cell_id", "execution_id", "plugin_worker_id", "plugin_id", "plugin_version", "family_id", "capabilities", "interaction", "created_at"],
      "properties": {
        "client_id": {"type": "string", "minLength": 3},
        "runtime_id": {"type": "string", "minLength": 3},
        "kernel_id": {"type": "string", "minLength": 3},
        "notebook_id": {"type": "string", "minLength": 1},
        "cell_id": {"type": "string", "minLength": 1},
        "execution_id": {"type": "string", "minLength": 3},
        "plugin_worker_id": {"type": "string", "minLength": 3},
        "plugin_id": {"type": "string", "minLength": 3},
        "plugin_version": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["execute", "followup", "complete", "interrupt", "editor_actions"]}},
        "interaction": {"enum": ["noninteractive", "request_response", "terminal_interactive"]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "ready"}}
      },
      "then": {
        "required": ["supervisor_id", "earliest_event_sequence", "event_sequence", "kernel", "runtime", "executions", "clients", "surfaces"]
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {"const": true},
        "operation": {"type": "object"},
        "kernel": {"type": ["object", "null"]},
        "runtime": {
          "type": ["object", "null"],
          "properties": {
            "runtime_id": {"type": "string", "minLength": 3},
            "notebook_id": {"type": "string", "minLength": 1},
            "discovery_id": {"type": "string", "minLength": 3},
            "kernel_id": {"type": "string", "minLength": 3},
            "plugin_catalog": {"$ref": "plugin-catalog.schema.json"}
          },
          "required": ["runtime_id", "notebook_id", "discovery_id", "kernel_id", "plugin_catalog"],
          "additionalProperties": false
        },
        "editor_actions": {"type": "array", "maxItems": 32, "items": {"$ref": "editor-actions.schema.json#/$defs/metadata"}},
        "client_operations": {"type": "array", "maxItems": 1, "items": {
          "type": "object", "required": ["operation_id", "client_id", "kind"],
          "properties": {"operation_id": {"type": "string", "minLength": 1},
                         "client_id": {"type": "string", "minLength": 1},
                         "kind": {"enum": ["followup", "complete", "editor_action"]}},
          "additionalProperties": false
        }},
        "clients": {"type": "array", "items": {"$ref": "#/$defs/client"}},
        "pending_input": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/input_request"}]},
        "input_reply": {
          "type": "object",
          "required": [
            "execution_id",
            "input_request_id"
          ],
          "properties": {
            "execution_id": {
              "type": "string",
              "minLength": 1
            },
            "input_request_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "executions": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/execution"}},
        "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
        "execution": {"type": "object"},
        "editor_action": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/editor_action"}]},
        "completion": {"$ref": "#/$defs/completion"},
        "result": {"type": "object"},
        "cleanup": {"type": "object"},
        "status": {"type": "string"},
        "supervisor_id": {"type": "string"},
        "earliest_event_sequence": {"type": "integer", "minimum": 1},
        "event_sequence": {"type": "integer", "minimum": 0},
        "failure": {"$ref": "common.schema.json#/$defs/failure"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["ok", "failure"],
      "properties": {
        "ok": {"const": false},
        "failure": {"$ref": "common.schema.json#/$defs/failure"}
      },
      "additionalProperties": false
    }
  ]
}
