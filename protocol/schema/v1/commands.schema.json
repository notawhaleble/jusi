{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusi.dev/protocol/v1/commands.schema.json",
  "title": "Jusi Protocol v1 Commands",
  "oneOf": [
    {"$ref": "#/$defs/start_kernel"},
    {"$ref": "#/$defs/execute"},
    {"$ref": "#/$defs/interrupt"},
    {"$ref": "#/$defs/submit_input"},
    {"$ref": "#/$defs/stop_kernel"},
    {"$ref": "#/$defs/complete"},
    {"$ref": "#/$defs/followup"},
    {"$ref": "#/$defs/interrupt_client"},
    {"$ref": "#/$defs/editor_action"},
    {"$ref": "#/$defs/ack_editor_action"},
    {"$ref": "#/$defs/close_client"},
    {"$ref": "#/$defs/restart_notebook"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol_version", "command_id", "trace_id", "kind"],
      "properties": {
        "protocol_version": {"const": 1},
        "command_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "trace_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "kind": {"type": "string"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "start_kernel": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "notebook_id", "kernel_name"],
          "properties": {
            "kind": {"const": "start_kernel"},
            "notebook_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "kernel_name": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "execute": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "kernel_id", "notebook_id", "cell_id", "code"],
          "properties": {
            "kind": {"const": "execute"},
            "kernel_id": {"type": "string", "minLength": 3, "maxLength": 128},
            "notebook_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "cell_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "code": {"type": "string"}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "submit_input": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "kernel_id",
            "execution_id",
            "input_request_id",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "submit_input"
            },
            "kernel_id": {
              "type": "string",
              "minLength": 1
            },
            "execution_id": {
              "type": "string",
              "minLength": 1
            },
            "input_request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "interrupt": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "kernel_id", "execution_id"],
          "properties": {
            "kind": {"const": "interrupt"},
            "kernel_id": {"type": "string", "minLength": 3, "maxLength": 128},
            "execution_id": {"type": "string", "minLength": 3, "maxLength": 128}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "stop_kernel": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "kernel_id"],
          "properties": {
            "kind": {"const": "stop_kernel"},
            "kernel_id": {"type": "string", "minLength": 3, "maxLength": 128}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "complete": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "kernel_id",
            "notebook_id",
            "cell_id",
            "body",
            "cursor_pos"
          ],
          "properties": {
            "kind": {
              "const": "complete"
            },
            "kernel_id": {
              "type": "string",
              "minLength": 1
            },
            "notebook_id": {
              "type": "string",
              "minLength": 1
            },
            "cell_id": {
              "type": "string",
              "minLength": 1
            },
            "client_id": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            },
            "cursor_pos": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "followup": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "client_id",
            "body"
          ],
          "properties": {
            "kind": {
              "const": "followup"
            },
            "client_id": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "interrupt_client": {
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "client_id",
        "operation_id"
      ],
      "properties": {
        "kind": {
          "const": "interrupt_client"
        },
        "client_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "unevaluatedProperties": false
},
    "editor_action": {
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "client_id",
        "action",
        "selection"
      ],
      "properties": {
        "kind": {
          "const": "editor_action"
        },
        "client_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "copy",
            "open",
            "show_diff"
          ]
        },
        "selection": {
          "type": "object"
        }
      }
    }
  ],
  "unevaluatedProperties": false
},
    "ack_editor_action": {
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "action_id",
        "editor_id",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "ack_editor_action"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "editor_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "delivered",
            "failed"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
},
    "close_client": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "client_id"],
          "properties": {
            "kind": {"const": "close_client"},
            "client_id": {"type": "string", "minLength": 3, "maxLength": 128}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "restart_notebook": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["kind", "runtime_id", "kernel_id", "notebook_id", "next_notebook_id", "kernel_name"],
          "properties": {
            "kind": {"const": "restart_notebook"},
            "runtime_id": {"type": "string", "minLength": 3, "maxLength": 128},
            "kernel_id": {"type": "string", "minLength": 3, "maxLength": 128},
            "notebook_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "next_notebook_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "kernel_name": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
